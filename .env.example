# ---- 共用 ----
NODE_ENV=development

# ---- API ----
API_PORT=3000
# PostgreSQL（地端買斷 / 雲端訂閱租戶皆以此連線字串設定）
DATABASE_URL=postgresql://wfms:wfms@localhost:5432/wfms?schema=public

# ---- Microsoft 365 / Entra ID SSO（OIDC，1.3）----
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:3000/auth/callback
# 申請的 OAuth scope（需包含 openid profile email 及 Graph User.Read 以讀取 /me 與 /me/memberOf）
ENTRA_SCOPES=openid profile email User.Read
# 角色對應：於資料庫 Role.entraGroupId 填入對應的 Entra 群組 Object ID（無需環境變數）

# ---- Session / 登入 ----
# 簽發系統 session cookie 的密鑰（正式環境請務必替換為隨機長字串）
AUTH_SESSION_SECRET=dev-insecure-secret-change-me
# session 有效期（秒），預設 8 小時
AUTH_SESSION_TTL=28800
# 登入成功後導回的前端位址（預設取 WEB_BASE_URL）
AUTH_POST_LOGIN_REDIRECT=http://localhost:5173

# ---- Web ----
WEB_BASE_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000
